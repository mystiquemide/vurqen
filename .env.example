# Vurqen provider mode: paper, read_only, or replay
VURQEN_MODE=paper

# Set this in production to protect private API routes.
VURQEN_API_TOKEN=

# BingX environment. prod-vst is the simulated trading environment.
BINGX_ENV=prod-vst
BINGX_API_KEY=
BINGX_SECRET_KEY=

# WEEX V3 paper or read-only credentials. Leave blank while access is pending.
WEEX_API_KEY=
WEEX_SECRET_KEY=
WEEX_PASSPHRASE=
WEEX_BASE_URL=https://api-contract.weex.com

# AI provider used only to explain structured evidence.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=

# Directory for append-only run and receipt storage.
VURQEN_DATA_DIR=./data
